{
  "name": "okfshare-cli-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run --if-present build",
    "typecheck": "pnpm -r --workspace-concurrency=1 run --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run --if-present test",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
